# Copy to .env and fill in. NEVER commit .env — it is gitignored.
#
# Generate an API wallet at https://app.hyperliquid.xyz/API
# An API wallet can TRADE but CANNOT WITHDRAW. Never put your main wallet's
# seed phrase or private key in this file.
HL_API_PRIVATE_KEY=0x...
# Your MAIN wallet's public address (not the API wallet's).
HL_ACCOUNT_ADDRESS=0x...
